---
import Layout from '../layouts/Layout.astro';

const title = 'Privacy — RelationOS';
const description =
  'How RelationOS handles your data: private by default, encrypted at rest, never sold.';
---

<Layout title={title} description={description}>
  <section class="relative z-10 px-5 pb-24 pt-36 sm:px-8">
    <div class="mx-auto max-w-3xl">
      <p class="overline">Legal</p>
      <h1 class="mt-4 font-display text-[clamp(2.4rem,5vw,3.6rem)] leading-[1.02] tracking-tight text-text text-balance">
        Privacy, <span class="italic text-primary">by default.</span>
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-text-muted text-pretty">
        Last updated: July 31, 2026. The short version: your data belongs to
        you, it starts private, and we never sell it. Here are the details.
      </p>

      <div class="mt-14 space-y-12">
        <div>
          <h2 class="font-display text-2xl text-text">What we collect</h2>
          <p class="mt-3 leading-relaxed text-text-muted text-pretty">
            An email address to create your account, and the content you
            choose to put in the app — wishlist items, plans, memories, and
            photos. That's it. We don't collect your contacts, your location
            history, or an advertising profile, because there is no
            advertising.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-text">What stays private</h2>
          <p class="mt-3 leading-relaxed text-text-muted text-pretty">
            Solo content is visible only to you — enforced at the database
            level, not just in the app's interface. Swipes are private by
            design: only mutual likes ever surface as matches, and your
            passes are never shown to anyone. Memories remain yours alone
            until you explicitly share one, and a partner can never unshare
            something you wrote.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-text">Where it lives</h2>
          <p class="mt-3 leading-relaxed text-text-muted text-pretty">
            Your data is stored with Supabase (PostgreSQL) and encrypted at
            rest. Photos are stored in private storage buckets that only you
            — or your paired circle, for shared items — can access.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-text">What we never do</h2>
          <p class="mt-3 leading-relaxed text-text-muted text-pretty">
            We never sell your data, never show ads, and never use your
            memories or messages to train models. If that ever changes, this
            page changes first — and you'll be able to leave with your data.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-text">Your rights</h2>
          <p class="mt-3 leading-relaxed text-text-muted text-pretty">
            You can export or delete your account and everything in it at any
            time. Questions or requests:
            <a href="mailto:hello@relationos.app" class="ml-1 font-semibold text-primary underline-offset-4 hover:underline">hello@relationos.app</a>.
          </p>
        </div>
      </div>

      <a href="/" class="mt-16 inline-flex items-center gap-2 rounded-full bg-text px-6 py-3 text-sm font-semibold text-bg transition-all hover:bg-primary hover:text-white">
        ← Back home
      </a>
    </div>
  </section>
</Layout>
