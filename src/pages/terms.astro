---
import Layout from '../layouts/Layout.astro';

const title = 'Terms — RelationOS';
const description =
  'The terms of service for RelationOS — plain language, no fine-print traps.';
---

<Layout title={title} description={description}>
  <section class="relative z-10 px-5 pb-24 pt-36 sm:px-8">
    <div class="mx-auto max-w-3xl">
      <p class="overline">Legal</p>
      <h1 class="mt-4 font-display text-[clamp(2.4rem,5vw,3.6rem)] leading-[1.02] tracking-tight text-text text-balance">
        Terms, in <span class="italic text-primary">plain words.</span>
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-text-muted text-pretty">
        Last updated: July 31, 2026. We've kept these short on purpose. If
        anything here is unclear, write to us — that's a bug we want fixed.
      </p>

      <div class="mt-14 space-y-12">
        <div>
          <h2 class="font-display text-2xl text-text">The app</h2>
          <p class="mt-3 leading-relaxed text-text-muted text-pretty">
            RelationOS is a personal space for planning dates and keeping
            memories, alone or with the people you choose to pair with. It's
            provided as-is, free of charge for now, while we figure out what
            a fair, sustainable model looks like.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-text">Your content</h2>
          <p class="mt-3 leading-relaxed text-text-muted text-pretty">
            Everything you create — plans, wishes, memories, photos — belongs
            to you. You grant us only the licence needed to store it and show
            it back to you (and to your paired circle, for things you
            explicitly share). We claim no ownership over your life.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-text">Pairing & consent</h2>
          <p class="mt-3 leading-relaxed text-text-muted text-pretty">
            Pairing always takes an explicit invite code from both sides.
            Nothing is shared with a partner without your action — past
            content stays private by default, and sharing is always a
            deliberate, per-item choice you can reason about.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-text">Fair use</h2>
          <p class="mt-3 leading-relaxed text-text-muted text-pretty">
            Don't use the app to harass, stalk, or control someone. Don't try
            to break into other people's data. Accounts that do will be
            removed.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-text">Leaving</h2>
          <p class="mt-3 leading-relaxed text-text-muted text-pretty">
            You can delete your account and all your data at any time, no
            hoops. If we ever shut the service down, we'll give you notice
            and a way to take your memories with you.
          </p>
        </div>
      </div>

      <a href="/" class="mt-16 inline-flex items-center gap-2 rounded-full bg-text px-6 py-3 text-sm font-semibold text-bg transition-all hover:bg-primary hover:text-white">
        ← Back home
      </a>
    </div>
  </section>
</Layout>
